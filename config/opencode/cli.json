{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "plugins": [
    "opencode-claude-quota"
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "permissions": "autoaccept"
  },
  "animations": true,
  "prompt": {
    "paste": "full"
  },
  "keybinds": {
    "agent.cycle": "tab",
    "agent.cycle.reverse": "shift+tab",
    "variant.cycle": "ctrl+w",
    "model.list": "ctrl+f",
    "model.cycle_favorite": "ctrl+e",
    "session.list": "ctrl+s",
    "mcp.list": "ctrl+r",
    "session.rename": "none"
  },
  "tabs": {
    "mode": "off"
  }
}
